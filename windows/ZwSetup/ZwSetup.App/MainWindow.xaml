<ui:FluentWindow x:Class="ZwSetup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:ZwSetup.App.Pages"
        xmlns:core="clr-namespace:ZwSetup.Core;assembly=ZwSetup.Core"
        Title="{Binding [AppTitle], Source={x:Static core:L.I}}"
        Width="900" Height="700" MinWidth="720" MinHeight="520"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding [AppTitle], Source={x:Static core:L.I}}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Fingerprint24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left" OpenPaneLength="210"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False"
                           FrameMargin="0">
            <ui:NavigationView.Header>
                <StackPanel Orientation="Horizontal" Margin="42,20,0,12" Visibility="Collapsed" />
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{Binding [Nav_Status], Source={x:Static core:L.I}}" TargetPageType="{x:Type pages:StatusPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding [Nav_Setup], Source={x:Static core:L.I}}" TargetPageType="{x:Type pages:SetupPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Key24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding [Nav_Fingers], Source={x:Static core:L.I}}" TargetPageType="{x:Type pages:FingersPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Fingerprint24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding [Nav_Log], Source={x:Static core:L.I}}" TargetPageType="{x:Type pages:LogPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DocumentText24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{Binding [Nav_Settings], Source={x:Static core:L.I}}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <Border Grid.Row="2" Padding="16,6" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:ProgressRing x:Name="BusyRing" Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusLine" Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
