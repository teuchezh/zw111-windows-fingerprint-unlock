<Page x:Class="ZwSetup.App.Pages.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:ZwSetup.Core;assembly=ZwSetup.Core">
    <!-- No ScrollViewer here: the WPF-UI NavigationView wraps every page in its own DynamicScrollViewer. -->
    <StackPanel Margin="24,16,24,24" MaxWidth="868">
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Setup_Title], Source={x:Static core:L.I}}" />

        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8" Text="{Binding [Setup_Account], Source={x:Static core:L.I}}" />
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Person24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_User], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_UserHint], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="UserBox" Width="300" />
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Globe24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Domain], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_DomainHint], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="DomainBox" Width="300" />
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Password24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Password], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_PasswordHint], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:PasswordBox x:Name="PassBox" Width="300" />
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Password24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Password2], Source={x:Static core:L.I}}" />
            </ui:CardControl.Header>
            <ui:PasswordBox x:Name="Pass2Box" Width="300" />
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Fingerprint24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Finger], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_FingerDesc], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="FingerBox" Width="90" Text="0" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Setup_DeviceGroup], Source={x:Static core:L.I}}" />
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="SerialPort24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Port], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_PortDesc], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="PortBox" Width="300" />
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="UsbStick24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_UsbId], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_UsbIdDesc], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="UsbBox" Width="300" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text=" " />
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Key24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Step1], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_Step1Desc], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary" MinWidth="120" Content="{Binding [Setup_Run], Source={x:Static core:L.I}}" Click="Provision_Click" />
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Checkmark24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Step3], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_Step3Desc], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button MinWidth="120" Content="{Binding [Setup_Run], Source={x:Static core:L.I}}" Click="Test_Click" />
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Password24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_ChangePw], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Setup_ChangePwDesc], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button MinWidth="120" Content="{Binding [Setup_Run], Source={x:Static core:L.I}}" Click="ChangePw_Click" />
        </ui:CardControl>
    </StackPanel>
</Page>
