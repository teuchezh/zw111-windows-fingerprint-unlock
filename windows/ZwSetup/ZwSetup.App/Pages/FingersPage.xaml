<Page x:Class="ZwSetup.App.Pages.FingersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:ZwSetup.Core;assembly=ZwSetup.Core">
    <!-- No ScrollViewer here: the WPF-UI NavigationView wraps every page in its own DynamicScrollViewer. -->
    <StackPanel Margin="24,16,24,24" MaxWidth="868">
        <Grid>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Fingers_Title], Source={x:Static core:L.I}}" />
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="{Binding [Led_Reload], Source={x:Static core:L.I}}" Click="Reload_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
            </ui:Button>
        </Grid>

        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Add24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Fingers_Add], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Fingers_AddDesc], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:TextBox x:Name="NewNameBox" Width="220" Margin="0,0,8,0" PlaceholderText="{Binding [Fingers_NameHint], Source={x:Static core:L.I}}" />
                <ui:Button Appearance="Primary" MinWidth="110" Content="{Binding [Fingers_AddBtn], Source={x:Static core:L.I}}" Click="Add_Click" />
            </StackPanel>
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Fingers_List], Source={x:Static core:L.I}}" />
        <TextBlock x:Name="ListStatus" Style="{StaticResource CardDesc}" Margin="0,0,0,8" />
        <StackPanel x:Name="SlotList" />

        <TextBlock Style="{StaticResource SectionTitle}" Text=" " />
        <ui:CardControl Style="{StaticResource Card}">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Eraser24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Fingers_Wipe], Source={x:Static core:L.I}}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Fingers_WipeDesc], Source={x:Static core:L.I}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Appearance="Danger" MinWidth="120" Content="{Binding [Setup_Run], Source={x:Static core:L.I}}" Click="Wipe_Click" />
        </ui:CardControl>
    </StackPanel>
</Page>
